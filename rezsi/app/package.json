{
  "name": "rezsi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @rezsi/web build && pnpm --filter @rezsi/server build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p web --noEmit && tsc -p scripts --noEmit",
    "lint": "eslint .",
    "seed": "tsx scripts/seed.ts",
    "import-sheet": "tsx scripts/import-sheet.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rezsi/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
